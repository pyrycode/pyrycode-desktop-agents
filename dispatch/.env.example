GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode-mobile
PROJECT_NUMBER=  # TBD — set to the GitHub Project number for pyrycode-mobile board (created at activation time)
GITHUB_TOKEN=ghp_your_token_here
# Optional: Discord webhook for notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# When activating this dispatcher, also set:
#   PYRYCODE_REPO_PATH=/absolute/path/to/pyrycode-mobile
# The default fallback (resolvePyrycodeRepoRoot) looks for a sibling dir named
# "pyrycode" — wrong for mobile. The env var override is the activation-clean path.
# See dispatch/src/dispatch.ts header comment for the rename-helper-to-resolveTargetRepoRoot
# refactor that's deferred until activation.
