# Copy to .env (gitignored) and fill in.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode-desktop
PROJECT_NUMBER=7
GITHUB_TOKEN=ghp_your_token_here
TARGET_REPO_PATH=/absolute/path/to/pyrycode-desktop

# Optional
# TARGET_DEFAULT_BRANCH=master   # default: main
# SALVAGE_GATES="npm run build"   # default: "go vet ./...; go build ./..." (set a JS build gate)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# PYRY_RECORD_DIR=/Users/you/.local/share/pyry-recordings
# PYRY_LOG_RETENTION_DAYS=30
# OWNER_TYPE=organization   # default: user

# AGENTS_REPO_PATH is set automatically by bin/pyry-start.

# Stage set. Unset (or "classic") runs the six-agent relay: po, architect,
# developer, qa, code-review, documentation. "builder" runs the four-role set
# piloted on pyrycode since 2026-09-01: refiner, builder, verifier,
# documentation. Backlog advances straight to In Development; In Architecture
# and In QA are never polled. Rollback is unsetting the variable and restarting.
# PYRY_STAGE_SET=builder
#
# Deterministic gates the dispatcher runs in the PR worktree BEFORE spawning the
# verifier (builder set only). `;`-separated shell commands, and the whole value
# MUST be quoted: the 1Password wrapper silently drops an unquoted value that
# contains spaces. A fresh worktree has no node_modules, so install first. The
# Playwright entry is the fake-transport e2e tier (real-* specs are excluded by
# the config); it launches the built Electron app from out/, so it must come
# after the build. Each gate has a 10-minute cap in the dispatcher; the full
# tier measured 53 specs in 42 seconds on 2026-09-01, well inside it.
# Green injects a gates-passed note into the verifier; red spawns it in triage
# mode with the failure attached. Set "" to skip the step entirely.
# PYRY_VERIFIER_GATES="npm install --no-audit --no-fund;npm run check:docs;npm test;npm run build;npx playwright test"
#
# Family circuit breaker: dispatches per ticket family (root + every split
# descendant) before the family is parked under error:family-breaker. The code
# default of 24 fired on a pyrycode family that was completing normally; 60
# sits near the ~66 dispatches the worst observed spiral reached.
# PYRY_FAMILY_DISPATCH_LIMIT=60
